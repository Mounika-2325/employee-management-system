# Backend Port (Defaults to 5000 locally; Render automatically sets PORT)
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/employee_management?retryWrites=true&w=majority

# Optional: Frontend URL for CORS (e.g. your Vercel deployment domain)
# Defaults to allowing *.vercel.app and localhost automatically
CLIENT_URL=https://your-frontend-app.vercel.app
